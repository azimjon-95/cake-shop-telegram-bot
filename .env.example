# Nusxa oling: cp .env.example .env  — va haqiqiy qiymatlarni o'zingiz to'ldiring (gitga QO'SHMANG)
PORT=6060
TZ=Asia/Tashkent
MONGO_URI=
REDIS_URL=            # ixtiyoriy — bo'sh bo'lsa RAM fallback
BOT_TOKEN=
BOT_PASSWORD=
ADMIN_TG_ID=
BAKER_TG_ID=
GROUP_CHAT_ID=        # masalan -100xxxxxxxxxx
STATS_CHAT_ID=        # ixtiyoriy
BACKUP_CHAT_ID=
GROUP_INVITE_LINK=
WEBAPP_URL=https://totli-inky.vercel.app
WEBAPP_ALLOWED_TG_IDS=
CUSTOMER_BOT_TOKEN=
CUSTOMER_BOT_USERNAME=
MIN_QR_PAID=
OPENAI_API_KEY=
# Chat model (sotuv/chiqim tahlili). STT modelidan MUSTAQIL. gpt-5.x ham ishlaydi (parametrlar avtomatik moslanadi)
OPENAI_MODEL=gpt-4o-mini
INSTA_GROUP_ID=
INSTA_ALLOWED_USER_IDS=
INSTA_POST_HOUR=
FFMPEG_PATH=

# ── FILIALLAR ──────────────────────────────────────────
# Har do'kon PIN-kodi (xodim /start bosib shuni kiritadi). Bir xil bo'lmasin!
PIN_SANG=             # bo'sh bo'lsa BOT_PASSWORD ishlatiladi
PIN_TODA=
# Guruh: bo'sh bo'lsa umumiy GROUP_CHAT_ID ga, tepada filial nomi bilan boradi
GROUP_CHAT_ID_SANG=
GROUP_CHAT_ID_TODA=
# Ixtiyoriy (chek va hisobotlar uchun)
BRANCH_SANG_NAME=Totli Sang
BRANCH_TODA_NAME=Totli To'da
BRANCH_SANG_ADDRESS=Sang'sentir, Anhor minosi
BRANCH_TODA_ADDRESS=
BRANCH_SANG_PHONE=
BRANCH_TODA_PHONE=

# ── 🧪 TEST filial (dasturchi uchun; ixtiyoriy) ──
# PIN_TEST berilsa yoqiladi. Test sotuv/chiqim/qarz va boshqalar alohida balansda,
# haqiqiy hisobotlarga (Sang/To'da/jami) aralashmaydi.
PIN_TEST=
# GROUP_CHAT_ID_TEST=        # bo'sh bo'lsa umumiy GROUP_CHAT_ID; xabarlar baribir o'chadi
# TEST_GROUP_DELETE_SEC=60   # guruhdagi test xabarlari necha soniyadan keyin o'chadi
# TEST_DATA_TTL_MIN=60       # test ma'lumotlari necha daqiqadan keyin bazadan o'chadi
# TEST_START_BALANCE=10000000  # test balansining boshlang'ich qiymati

# ── 🎤 Ovozli xabar / STT ──
# Eslatma: gpt-4o-mini-transcribe OpenAI tomonidan 2027-02-26 da o'chiriladi — shundan oldin yangi modelga o'ting
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
VOICE_MAX_SEC=40
VOICE_MIN_SEC=1
VOICE_MAX_FILE_MB=20
VOICE_PROCESS_TIMEOUT_MS=90000
VOICE_DOWNLOAD_TIMEOUT_MS=20000
VOICE_FFMPEG_TIMEOUT_MS=30000
VOICE_MAX_RETRIES=2
VOICE_USER_CONCURRENCY=1
FFMPEG_PATH=ffmpeg
# STT tili: bo'sh = avtomatik aniqlash (uz/ru aralash nutq uchun tavsiya). Majburlash: STT_LANGUAGE=uz (ISO-639-1)
# STT_LANGUAGE=
